---
import PrototypeLayout from '@layouts/PrototypeLayout.astro';
import PrototypeHome from '@components/react/PrototypeHome.tsx';
---

<PrototypeLayout title="Prototype · Theta Tau">
  <PrototypeHome client:load />
</PrototypeLayout>

<style is:global>
  /* ---- Revamp prototype (.pt-*), restrained, scale.com-style. ---------- */
  :root {
    --pt-bg: #0b0908;
    --pt-fg: #f4eee2;
    --pt-muted: rgba(244, 238, 226, 0.52);
    --pt-line: rgba(244, 238, 226, 0.12);
    --pt-accent: #c8a24c; /* one disciplined accent */
    --pt-maroon: #7c0303;
  }

  .pt-page {
    background: var(--pt-bg);
    color: var(--pt-fg);
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  .pt-page * {
    box-sizing: border-box;
  }

  .pt-eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pt-accent);
  }

  /* ---- Hero ---- */
  .pt-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 6vw;
    overflow: hidden;
  }
  .pt-hero__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .pt-hero__glow span {
    position: absolute;
    top: 18%;
    left: 42%;
    width: 60vw;
    height: 60vw;
    background: rgba(124, 3, 3, 0.55);
    filter: blur(30px);
  }
  .pt-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 68rem;
  }
  .pt-h1 {
    margin: 1.4rem 0 0;
    font-size: clamp(2.6rem, 8.5vw, 7.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .pt-lead {
    margin: 2rem 0 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    color: var(--pt-muted);
  }
  .pt-hero__cue {
    position: absolute;
    bottom: 4vh;
    right: 6vw;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pt-muted);
    writing-mode: vertical-rl;
  }

  /* ---- Generic section rhythm ---- */
  .pt-section {
    padding: clamp(9rem, 18vh, 16rem) 6vw;
    max-width: 90rem;
    margin: 0 auto;
  }

  /* ---- Statement ---- */
  .pt-statement {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }
  .pt-statement__line {
    display: block;
    font-size: clamp(2rem, 6vw, 5.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .pt-statement__line--muted {
    color: var(--pt-muted);
  }

  /* ---- Pinned horizontal pillars ---- */
  .pt-pinned {
    background: var(--pt-bg);
  }
  .pt-pinned__intro {
    flex: 0 0 auto;
    width: min(42vw, 26rem);
    align-self: center;
    padding-right: 2vw;
  }
  .pt-pinned__lead {
    margin: 1rem 0 0;
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .pt-panel {
    flex: 0 0 auto;
    width: min(78vw, 34rem);
    height: 62vh;
    border: 1px solid var(--pt-line);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(244, 238, 226, 0.02);
  }
  .pt-panel__num {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--pt-accent);
  }
  .pt-panel__title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pt-panel__body {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: var(--pt-muted);
  }

  /* ---- Stats ---- */
  .pt-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-top: 1px solid var(--pt-line);
    border-bottom: 1px solid var(--pt-line);
  }
  .pt-stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pt-stat__value {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .pt-stat__label {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--pt-muted);
  }
  @media (max-width: 640px) {
    .pt-stats {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ---- CTA ---- */
  .pt-cta {
    text-align: center;
  }
  .pt-cta__title {
    margin: 0;
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pt-cta__body {
    margin: 1.25rem auto 0;
    max-width: 34rem;
    color: var(--pt-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
  }
  .pt-cta__btn {
    display: inline-block;
    margin-top: 2.5rem;
    padding: 0.95rem 1.9rem;
    border-radius: 999px;
    background: var(--pt-accent);
    color: #17110a;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background 0.25s ease;
  }
  .pt-cta__btn:hover {
    transform: translateY(-2px);
    background: #d8b25c;
  }

  /* ---- Footer ---- */
  .pt-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 3rem 6vw 4rem;
    border-top: 1px solid var(--pt-line);
    font-size: 0.8rem;
    color: var(--pt-muted);
  }
  .pt-foot a {
    color: var(--pt-fg);
    text-decoration: none;
  }
</style>
