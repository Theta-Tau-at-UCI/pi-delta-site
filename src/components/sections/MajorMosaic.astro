---
// MajorMosaic, clickable tile grid that doubles as a filter for the
// BrothersExplorer above. Each tile shows the major name and the number of
// current brothers in that major. Clicking dispatches a `brothers:filter`
// event that the explorer listens for; it replaces any existing Major
// filter and smooth-scrolls back to the roster.
import { allActives } from '@data/chapter';

const majorCounts = new Map<string, number>();
for (const b of allActives) {
  majorCounts.set(b.major, (majorCounts.get(b.major) ?? 0) + 1);
}
const majors = [...majorCounts.entries()]
  .map(([major, count]) => ({ major, count }))
  .sort((a, b) => b.count - a.count || a.major.localeCompare(b.major));

const max = Math.max(...majors.map((m) => m.count), 1);
---

<div class="major-mosaic" data-stagger>
  {
    majors.map(({ major, count }) => {
      // Tile prominence scales with count, top majors get a slightly larger
      // type ramp so the mosaic reads as a leaderboard at a glance.
      const intensity = count / max;
      const isLeader = count === max;
      return (
        <button
          type="button"
          class:list={['major-tile', isLeader && 'is-leader']}
          style={`--intensity: ${intensity};`}
          data-filter-type="major"
          data-filter-value={major}
          aria-label={`Filter roster by ${major} (${count} ${count === 1 ? 'brother' : 'brothers'})`}
        >
          <span class="major-tile__count font-display" aria-hidden="true">
            {count}
          </span>
          <span class="major-tile__name">{major}</span>
          <span class="major-tile__rule" aria-hidden="true" />
        </button>
      );
    })
  }
</div>

<script>
  document.querySelectorAll('.major-tile').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-filter-type');
      const value = btn.getAttribute('data-filter-value');
      if (!type || !value) return;
      document.dispatchEvent(new CustomEvent('brothers:filter', { detail: { type, value } }));
    });
  });

  // Recompute the count badge on each major tile when the active filters
  // change, show how many brothers in each major remain visible under
  // the current filter composition.
  document.addEventListener('brothers:filtered', (e) => {
    const detail = (e as CustomEvent<{ brothers: Array<{ major: string }> }>).detail;
    if (!detail?.brothers) return;
    const counts: Record<string, number> = {};
    for (const b of detail.brothers) counts[b.major] = (counts[b.major] ?? 0) + 1;
    const max = Math.max(0, ...Object.values(counts));
    document.querySelectorAll<HTMLElement>('.major-tile').forEach((tile) => {
      const major = tile.getAttribute('data-filter-value') ?? '';
      const count = counts[major] ?? 0;
      const countEl = tile.querySelector<HTMLElement>('.major-tile__count');
      if (countEl) countEl.textContent = String(count);
      tile.style.setProperty('--intensity', String(max > 0 ? count / max : 0));
      tile.classList.toggle('is-leader', count > 0 && count === max);
    });
  });

  // Highlight tiles whose major is currently in the active filter set, so
  // multi-select composition is visible while the drawer stays open.
  document.addEventListener('brothers:active-filters', (e) => {
    const detail = (e as CustomEvent<{ active: Array<{ type: string; values: string[] }> }>).detail;
    const active = detail?.active ?? [];
    document.querySelectorAll<HTMLElement>('.major-tile').forEach((tile) => {
      const type = tile.getAttribute('data-filter-type');
      const value = tile.getAttribute('data-filter-value') ?? '';
      const on = active.some((f) => f.type === type && f.values.includes(value));
      tile.classList.toggle('is-active', on);
      tile.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  });
</script>

<style>
  .major-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.6rem;
  }

  .major-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 1rem 1rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    overflow: hidden;
    transition:
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  :global(html.dark) .major-tile {
    background: rgba(74, 4, 4, 0.32);
  }

  /* Gold-tinted backdrop intensity tracks the brother count so the biggest
     majors visually "fill in." Quiet, never overwhelms the type. */
  .major-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(212, 181, 106, calc(var(--intensity, 0) * 0.18));
    pointer-events: none;
  }

  .major-tile:hover {
    transform: translateY(-3px);
    border-color: var(--color-gold-muted);
    box-shadow: 0 10px 22px rgba(74, 4, 4, 0.08);
  }
  .major-tile:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 2px;
  }
  /* Selected state, this major is part of the active filter set. */
  .major-tile.is-active {
    border-color: var(--color-accent-500);
    box-shadow: inset 0 0 0 2px var(--color-accent-500);
  }
  @media (prefers-reduced-motion: reduce) {
    .major-tile {
      transition: none;
    }
    .major-tile:hover {
      transform: none;
    }
  }

  .major-tile__count {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent-600);
    z-index: 1;
  }
  :global(html.dark) .major-tile__count {
    color: var(--color-accent-400);
  }
  .major-tile.is-leader .major-tile__count {
    color: var(--color-gold);
  }

  .major-tile__name {
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text);
    z-index: 1;
  }
  :global(html.dark) .major-tile__name {
    color: #ffffff;
  }

  /* Thin gold rule beneath the type, grows on hover, like the Pillars cards.
     Anchors the click-affordance without needing a button shape. */
  .major-tile__rule {
    display: block;
    width: 1.8rem;
    height: 2px;
    background: var(--color-accent-500);
    border-radius: 2px;
    margin-top: auto;
    transition: width 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: 1;
  }
  .major-tile:hover .major-tile__rule {
    width: 3.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .major-tile__rule,
    .major-tile:hover .major-tile__rule {
      transition: none;
    }
  }
</style>
