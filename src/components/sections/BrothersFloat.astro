---
// BrothersFloat, a drifting marquee of circle portraits used as a moving
// background layer. No headings, no CTAs, no tooltips: this is a primitive,
// not a section. Two variants:
//
//   - "background"  Fills its parent absolutely, low opacity, several rows,
//                   slow drift. Sits behind hero/page text and reads as a
//                   gradient-feeling wash of brothers.
//   - "tile"        Fills its parent absolutely, normal opacity, fewer rows.
//                   Used inside compact card tiles (e.g. the Brothers bento
//                   tile on the home page).
//
// The parent must be `position: relative; overflow: hidden`, the component
// positions itself absolute and fills the available space.
import { allActives } from '@data/chapter';

interface Props {
  variant?: 'background' | 'tile';
  /** Optional override for how many rows to render. */
  rows?: number;
}

const { variant = 'background', rows: rowsOverride } = Astro.props;

function initials(name: string): string {
  return name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

// Default row counts per variant, backgrounds get more density to feel like
// an ambient field, tiles get fewer so the layered text stays readable.
const rowCount = rowsOverride ?? (variant === 'background' ? 4 : 3);

// Split the roster across rows so every row gets a roughly equal share, then
// duplicate each row for seamless translateX(-50%) looping.
function chunkByRow<T>(arr: T[], count: number): T[][] {
  const out: T[][] = Array.from({ length: count }, () => []);
  arr.forEach((item, i) => {
    const bucket = out[i % count];
    if (bucket) bucket.push(item);
  });
  return out;
}
const rowsData = chunkByRow(allActives, rowCount).map((row) => [...row, ...row]);

// Per-row animation tuning. Even rows scroll left, odd rows scroll right;
// staggered durations keep the streams from syncing up.
const rowDurations = ['72s', '96s', '84s', '108s', '90s', '78s'];
---

<div
  class:list={['brothers-float', `brothers-float--${variant}`]}
  data-variant={variant}
  aria-hidden="true"
>
  {
    rowsData.map((row, rowIndex) => (
      <ul
        class:list={[
          'brothers-float__track',
          rowIndex % 2 === 0 ? 'brothers-float__track--left' : 'brothers-float__track--right',
        ]}
        style={`animation-duration: ${rowDurations[rowIndex] ?? '90s'};`}
      >
        {row.map((b) => (
          <li class:list={['brothers-float__chip', `brothers-float__chip--${b.tier}`]}>
            {b.photo ? (
              <img
                src={b.photo}
                alt=""
                class="brothers-float__chip-img"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="font-display brothers-float__chip-initials">{initials(b.name)}</span>
            )}
          </li>
        ))}
      </ul>
    ))
  }
</div>

<style>
  .brothers-float {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 0.6rem;
    pointer-events: none;
    overflow: hidden;
  }
  /* Tile variant: pack the two rows close together, sitting slightly above
     center so the copy at the bottom of the card breathes. */
  .brothers-float--tile {
    justify-content: center;
    padding-bottom: 5.5rem;
    gap: 0.45rem;
    /* Soft edge fades so circles dissolve into the parent rather than hard-cut. */
    mask-image:
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  /* Background variant lives behind page text, drop opacity so titles read
     cleanly on top of the drifting field. */
  .brothers-float--background {
    z-index: 0;
    opacity: 0.32;
  }
  :global(html.dark) .brothers-float--background {
    opacity: 0.42;
  }

  /* Tile variant lives inside a bento card, full opacity, smaller chips. */
  .brothers-float--tile {
    z-index: 0;
    opacity: 0.95;
  }

  /* --------------------------------------------------------------------- */
  /*   Rows                                                                  */
  /* --------------------------------------------------------------------- */
  .brothers-float__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    will-change: transform;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .brothers-float__track--left {
    animation-name: brothers-float-x;
  }
  .brothers-float__track--right {
    animation-name: brothers-float-x-reverse;
  }
  @keyframes brothers-float-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes brothers-float-x-reverse {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brothers-float__track--left,
    .brothers-float__track--right {
      animation: none;
      transform: translateX(-10%);
    }
  }

  /* --------------------------------------------------------------------- */
  /*   Chip                                                                  */
  /* --------------------------------------------------------------------- */
  .brothers-float__chip {
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    border-radius: 9999px;
    background: var(--color-brand-700);
    border: 1px solid rgba(212, 181, 106, 0.32);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-400);
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(212, 181, 106, 0.12),
      0 6px 14px rgba(74, 4, 4, 0.14);
  }
  .brothers-float--background .brothers-float__chip {
    width: clamp(2.5rem, 4vw, 3.6rem);
  }
  .brothers-float--tile .brothers-float__chip {
    /* Larger chips for the bento tile, two rows of these read as a
       substantial portrait field that fills the card. */
    width: clamp(4.75rem, 7.5vw, 6.5rem);
  }
  .brothers-float__chip--exec {
    border-color: var(--color-accent-500);
    box-shadow:
      inset 0 0 0 1px rgba(212, 181, 106, 0.3),
      0 8px 18px rgba(74, 4, 4, 0.22);
  }
  .brothers-float__chip--alumni {
    opacity: 0.7;
  }

  .brothers-float__chip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .brothers-float__chip-initials {
    font-size: clamp(0.7rem, 1.4vw, 0.95rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent-400);
  }
  .brothers-float__chip--exec .brothers-float__chip-initials {
    color: var(--color-gold);
  }
</style>
