---
// YearChips, clickable year-of-study chips for the brothers filter drawer.
// Renders a fixed set of academic-year labels (1st year through 5th+).
// Clicking dispatches the same `brothers:filter` event the other visual
// filters use. If no brother in `actives` has a `year` field set yet, the
// chips render with a note explaining how to enable the filter.
import { allActives } from '@data/chapter';

const YEARS = ['1st year', '2nd year', '3rd year', '4th year', '5th+ year'];

const counts = new Map<string, number>();
for (const b of allActives) {
  if (b.year) counts.set(b.year, (counts.get(b.year) ?? 0) + 1);
}
const anyYearData = counts.size > 0;
---

<div class="year-chips">
  <div class="year-chips__row" data-stagger>
    {
      YEARS.map((y) => {
        const count = counts.get(y) ?? 0;
        return (
          <button
            type="button"
            class="year-chip"
            data-filter-type="year"
            data-filter-value={y}
            aria-label={`Filter roster by ${y} (${count} ${count === 1 ? 'brother' : 'brothers'})`}
          >
            <span class="font-display year-chip__label">{y}</span>
            <span class="year-chip__count" aria-hidden="true">
              {count}
            </span>
          </button>
        );
      })
    }
  </div>
  {
    !anyYearData && (
      <p class="year-chips__note">
        Year of study isn't tracked on each brother yet. Add a <code>year</code> value (e.g.{' '}
        <code>"3rd year"</code>) to entries in <code>src/data/chapter.ts</code> and these chips will
        populate.
      </p>
    )
  }
</div>

<script>
  document.querySelectorAll('.year-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-filter-type');
      const value = btn.getAttribute('data-filter-value');
      if (!type || !value) return;
      document.dispatchEvent(new CustomEvent('brothers:filter', { detail: { type, value } }));
    });
  });

  // Refresh the count on each year chip when the active filters change.
  document.addEventListener('brothers:filtered', (e) => {
    const detail = (e as CustomEvent<{ brothers: Array<{ year?: string }> }>).detail;
    if (!detail?.brothers) return;
    const counts: Record<string, number> = {};
    for (const b of detail.brothers) {
      if (b.year) counts[b.year] = (counts[b.year] ?? 0) + 1;
    }
    document.querySelectorAll<HTMLElement>('.year-chip').forEach((chip) => {
      const year = chip.getAttribute('data-filter-value') ?? '';
      const countEl = chip.querySelector<HTMLElement>('.year-chip__count');
      if (countEl) countEl.textContent = String(counts[year] ?? 0);
    });
  });
</script>

<style>
  .year-chips {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .year-chips__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .year-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  :global(html.dark) .year-chip {
    background: rgba(74, 4, 4, 0.32);
  }
  .year-chip:hover {
    transform: translateY(-1px);
    border-color: var(--color-gold-muted);
    box-shadow: 0 6px 14px rgba(74, 4, 4, 0.06);
  }
  .year-chip:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .year-chip {
      transition: none;
    }
    .year-chip:hover {
      transform: none;
    }
  }
  .year-chip__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.005em;
  }
  :global(html.dark) .year-chip__label {
    color: #ffffff;
  }
  .year-chip__count {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .year-chips__note {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0;
  }
  .year-chips__note code {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New',
      monospace;
    font-size: 0.85em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
  }
  :global(html.dark) .year-chips__note code {
    background: rgba(212, 181, 106, 0.1);
    border-color: rgba(212, 181, 106, 0.18);
  }
</style>
